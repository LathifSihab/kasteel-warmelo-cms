# Copy to .env for local development. In production set these as Cloudflare secrets
# (wrangler secret put NAME) — never commit real values.

# Neon Postgres (pooled connection string). Leave empty locally to use a PGlite database in .data/
DATABASE_URL=

# Shared admin password, and a long random string to sign sessions (32+ characters)
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Uploads need nothing here: the site uses the R2 binding MEDIA (wrangler.jsonc), a local bucket in
# dev. Only scripts/import-legacy.ts copies files, through R2's S3 API with an R2 API token
# (Cloudflare dashboard → R2 → Manage API tokens, Object Read & Write on the bucket):
MEDIA_BUCKET=kasteel-warmelo-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<account-id>.r2.cloudflarestorage.com
AWS_REGION=auto
