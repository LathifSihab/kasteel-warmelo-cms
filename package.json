{
	"name": "warmelo-cms",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "node -e \"require('fs').rmSync('.svelte-kit/cloudflare',{recursive:true,force:true})\" && wrangler types",
		"db:migrate": "tsx --env-file-if-exists=.env scripts/db.ts migrate",
		"db:app-role": "tsx --env-file-if-exists=.env scripts/db.ts app-role",
		"import:legacy": "tsx --env-file-if-exists=.env scripts/import-legacy.ts",
		"legacy:convert": "node scripts/legacy/convert.mjs ../Warmelo && prettier --write \"src/routes/(site)\" src/lib/site/components",
		"legacy:parity": "node scripts/legacy/parity.mjs ../Warmelo http://localhost:5173"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.13",
		"@eslint/js": "^10.0.1",
		"@neon/config": "^1.9.6",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@neon/env": "^1.6.6",
		"@neondatabase/serverless": "^1.2.0",
		"aws4fetch": "^1.0.20"
	}
}
