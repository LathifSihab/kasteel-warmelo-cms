{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kasteel-warmelo-cms",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Uploaded images and videos (served through /media/…). In dev: a local bucket in .wrangler/state.
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kasteel-warmelo-media" }],
	// Workers Custom Domains: Cloudflare creates the DNS records and certificates on deploy
	"routes": [
		{ "pattern": "kasteelwarmelo.nl", "custom_domain": true },
		{ "pattern": "www.kasteelwarmelo.nl", "custom_domain": true }
	],
	"workers_dev": true,
	"preview_urls": true
}
